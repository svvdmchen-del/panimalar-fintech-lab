{
  "hosting": {
    "site": "panimalar-mba-fintech",
    "public": "hosting-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://panimalar-fintech-lab--panimalar-mba-fintech.asia-southeast1.hosted.app/",
        "type": 302
      },
      {
        "source": "/:path*",
        "destination": "https://panimalar-fintech-lab--panimalar-mba-fintech.asia-southeast1.hosted.app/:path*",
        "type": 302
      }
    ]
  }
}
